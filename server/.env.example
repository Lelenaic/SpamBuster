# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# OAuth providers (server-side secrets for Google/Microsoft auth flows)
#--------------------------------------------------------------------
# Google: create OAuth client ID (type "Web application") and register the
# redirect URI ${APP_URL}/api/v1/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: register an app and enable public client flows
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant ID for Microsoft (use "common" for multitenant)
MICROSOFT_TENANT_ID=common